{
  "name": "ap3x-records",
  "version": "0.1.0",
  "private": true,
  "description": "AP3X Records - static music listening site",
  "author": "AP3X Records <ap3x.records@proton.me>",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "homepage": "https://github.com/ap3demak-rgb/Ap3X",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ap3demak-rgb/Ap3X.git"
  },
  "bugs": {
    "url": "https://github.com/ap3demak-rgb/Ap3X/issues",
    "email": "ap3x.records@proton.me"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run verifier && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icones": "tsx scripts/generer-icones.ts",
    "verifier:licences": "tsx scripts/verifier-licences.ts",
    "verifier:i18n": "tsx scripts/verifier-i18n.ts",
    "verifier:mentions": "tsx scripts/verifier-mentions.ts",
    "verifier:docs": "tsx scripts/verifier-docs.ts",
    "verifier": "npm run verifier:licences && npm run verifier:i18n && npm run verifier:mentions && npm run verifier:contrastes",
    "prepare": "husky",
    "tags-id3": "tsx scripts/ecrire-tags-id3.ts",
    "catalogue": "tsx scripts/generer-catalogue.ts",
    "predev": "npm run catalogue",
    "prebuild": "npm run catalogue",
    "test": "vitest run",
    "test:watch": "vitest",
    "verifier:contrastes": "tsx scripts/verifier-contrastes.ts",
    "e2e": "playwright test",
    "postbuild": "tsx scripts/generer-pages-statiques.ts && tsx scripts/nettoyer-dist.ts",
    "verifier:budget": "tsx scripts/verifier-budget.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "node-id3": "^0.2.9",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "mpg123-decoder": "^1.0.3",
    "music-metadata": "^12.1.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
